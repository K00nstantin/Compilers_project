MODULE TestIs;
  TYPE
    Point = RECORD x, y: INTEGER END;
    Point3D = RECORD (Point) z: INTEGER END;
  VAR p3: Point3D;
      result: INTEGER;
  PROCEDURE Check;
  BEGIN
    p3.z := 5;
    IF (p3 IS Point3D) THEN
      result := 0
    ELSE
      result := 1
    END
  END Check;
BEGIN
  Check
END TestIs.
